# Copie para .env.local e preencha, ou rode `vercel env pull --yes`.
# Nunca commite valores reais.

# Postgres (Neon). Provisionado por `vercel integration add neon`.
DATABASE_URL=

# Segredo dos tokens JWT. Obrigatório em produção.
JWT_SECRET=

# KV/Upstash — só contadores de rate limit. Ausentes, rate limiting fica desligado.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternativa: nomes usados quando o KV vem de uma integração Upstash direta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client ID OAuth do Google. Só necessário para o login com Google.
GOOGLE_CLIENT_ID=
